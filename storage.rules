// Firebase Storage Security Rules for Spark/Blaze Plan

rules_version = '2';

service firebase.storage {
  function isSignedIn() {
    return request.auth != null;
  }

  function callerRole() {
    return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
  }

  function callerSchoolId() {
    return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.schoolId;
  }

  function isSuperAdmin() {
    return isSignedIn() && callerRole() == 'superadmin';
  }

  function isMemberOfSchool(schoolId) {
    return isSignedIn() && (isSuperAdmin() || callerSchoolId() == schoolId);
  }

  function canManageSchoolAssets(schoolId) {
    return isMemberOfSchool(schoolId) && (
      isSuperAdmin() ||
      callerRole() == 'schooladmin' ||
      callerRole() == 'registrar'
    );
  }

  function targetUserSchoolId(userId) {
    return firestore.get(/databases/(default)/documents/users/$(userId)).data.schoolId;
  }

  function canAccessUserAsset(userId) {
    return isSignedIn() && (
      isSuperAdmin() ||
      request.auth.uid == userId ||
      callerSchoolId() == targetUserSchoolId(userId)
    );
  }

  function canManageUserAsset(userId) {
    return isSignedIn() && (
      isSuperAdmin() ||
      request.auth.uid == userId ||
      (callerSchoolId() == targetUserSchoolId(userId) && (
        callerRole() == 'schooladmin' ||
        callerRole() == 'registrar'
      ))
    );
  }

  match /b/{bucket}/o {
    //
    // SCHOOL RESOURCES (Logos, Signatures, etc.)
    //
    match /schools/{schoolId}/{allPaths=**} {
      allow read: if isMemberOfSchool(schoolId);
      allow write: if canManageSchoolAssets(schoolId);
    }
    
    //
    // USER PICTURES (Passport photos, etc.)
    //
    match /users/{userId}/{allPaths=**} {
      allow read: if canAccessUserAsset(userId);
      allow write: if canManageUserAsset(userId);
    }
  }
}
