// Firebase Storage Security Rules for Spark/Blaze Plan

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if the caller has a specific role in the users database
    function hasRole(role) {
      return request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == role;
    }

    //
    // SCHOOL RESOURCES (Logos, Signatures, etc.)
    //
    match /schools/{schoolId}/{allPaths=**} {
      allow read: if true; // Public read so report card templates can load images
      allow write: if request.auth != null && (
        hasRole('superadmin') || 
        hasRole('schooladmin') || 
        hasRole('registrar')
      );
    }
    
    //
    // USER PICTURES (Passport photos, etc.)
    //
    match /users/{userId}/{allPaths=**} {
      allow read: if true; // Public read so profiles and report cards load photos
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        hasRole('superadmin') || 
        hasRole('schooladmin') || 
        hasRole('registrar')
      );
    }
  }
}
