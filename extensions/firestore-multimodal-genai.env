# Cloud Functions region
LOCATION=us-central1

# Gemini API Provider: 'google-ai' or 'vertex-ai'
GEMINI_PROVIDER=google-ai

# Gemini Model to use for generation (gemini-1.5-flash is fast, cost-effective, and multimodal)
MODEL=gemini-1.5-flash

# Firestore collection path to monitor for new documents
COLLECTION_PATH=schools/{schoolId}/ai_grading

# The template prompt sent to Gemini. Supports Handlebars placeholders.
PROMPT=You are an expert academic grading assistant. Grade this student submission based on the parameters provided below:

Class: {{className}}
Subject: {{subjectName}}
Assignment Title: {{assignmentName}}

Student's Written Submission:
{{studentAnswer}}

Please perform the following operations:
1. Grade the submission out of 100 points, explaining the breakdown.
2. Highlight key strengths (what the student did well).
3. Identify areas of improvement (what could be better).
4. Provide a constructive, encouragement-filled summary of feedback.

Ensure your output is clear, formatted beautifully with markdown, and uses professional tone.

# Name of the document field containing an image reference in Cloud Storage (optional, for handwritten scan grading)
IMAGE_FIELD=attachmentUrl

# Comma-separated list of document fields used as variables in the prompt template
VARIABLE_FIELDS=className,subjectName,assignmentName,studentAnswer

# Name of the field where the extension will write the generated AI response
RESPONSE_FIELD=feedback

# Name of the field where any processing status or errors will be logged
STATUS_FIELD=status

# Candidate count (number of responses to generate)
CANDIDATE_COUNT=1

# Temperature (randomness) for generation (0.2 is focused and analytical, perfect for grading)
TEMPERATURE=0.2

# The Firestore database ID
FIRESTORE_DATABASE_ID=(default)
