# Cloud Functions region
LOCATION=us-central1

# Comma-separated list of paths in Cloud Firestore containing user data to delete.
# Uses {UID} as a placeholder for the deleted user's ID.
FIRESTORE_PATHS=users/{UID},schools/{schoolId}/users/{UID}

# Deletion mode for Firestore documents. 'recursive' deletes all nested subcollections as well.
FIRESTORE_DELETE_MODE=recursive

# Whether to automatically discover and delete Firestore documents containing the UID.
ENABLE_AUTO_DISCOVERY=Yes

# Comma-separated list of Realtime Database paths to delete (if any)
REALTIME_DATABASE_PATHS=

# Comma-separated list of Cloud Storage paths containing user files.
# Uses {DEFAULT} for the default bucket and {UID} for the user ID.
STORAGE_PATHS={DEFAULT}/users/{UID}

# The ID of the Firestore database
FIRESTORE_DATABASE_ID=(default)
