# Cloud Functions region
LOCATION=us-central1

# Target Cloud Storage bucket to monitor
STORAGE_BUCKET={DEFAULT}

# Sizes of resized images (comma-separated list of dimensions)
IMG_SIZES=200x200,500x500

# Whether to delete the original image after resizing is complete
DELETE_ORIGINAL_FILE=false

# Optional folder path where resized images should be saved.
# If blank, resized images are stored in the same folder as the original file.
RESIZED_IMAGES_PATH=

# Convert images to a modern format (webp saves up to 80% bandwidth over jpeg/png)
IMAGE_TYPE=webp

# Output quality options for selected format
IMAGE_TYPE_OPTIONS={"webp": {"quality": 85}}

# Make resized images publicly readable via standard URL
MAKE_PUBLIC=true

# Cache-Control header for resized images (cache in browser for 1 year)
CACHE_CONTROL_HEADER=public, max-age=31536000

# Paths to listen to for uploads (comma-separated). Monitors everything if blank.
PATHS_TO_LISTEN=

# Paths to ignore (comma-separated)
PATHS_TO_IGNORE=

# Memory allocated to the Cloud Function (MB)
FUNCTION_MEMORY=2048
